import java.util.Arrays;
import java.util.stream.IntStream;

class Solution {
    static int[] parent;
    public int solution(int n, int[][] costs) {
        Arrays.sort(costs, (p,c)->p[2]-c[2]);
        parent = IntStream.range(0, n).toArray();
        int selectedEdges = 0;
        int totalCost = 0;
        for(int[] edge : costs) {
        	if(!union(edge[0],edge[1])) continue;
        	totalCost+=edge[2];
        	if(++selectedEdges==n-1) return totalCost;
        }
        return totalCost;
    }
    boolean union(int a, int b) {
    	a = find(a);
    	b = find(b);
    	if(a==b) return false;
    	parent[b]=a;
    	return true;
    }
    int find(int x) {
    	if(parent[x]==x) return x;
    	return parent[x] = find(parent[x]);
    }
}
